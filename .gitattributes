# Text files are UTF-8 compatible in this repository and use LF line endings.
* text=auto eol=lf

# Source files
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.http text eol=lf
*.ts text eol=lf
*.mts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf

# Configuration and documentation
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Package manager lock files
package-lock.json text eol=lf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
